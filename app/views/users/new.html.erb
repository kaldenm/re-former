<%= form_with model: @user do |form| %>
  <%= form.label :user_name, "Your username" %>
  <%= form.text_field :user_name, placeholder: "Enter username" %>
  <br></br>

  <%= form.label :password, "Secret password" %>
  <%= form.password_field :password, placeholder: "Enter password" %>
<br></br>

  <%= form.label :email, "Emial address vibes"%>
  <%= form.email_field :email, placeholder: "Enter email" %>
  <br></br>
  <%= form.submit %>
<% end %>
